{
  "name": "colorado-watchdog-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "format": "biome format --write src scripts tests website/site/report-demo.js website/site/community-voices.css website/site/report-interface.css website/site/staff-reports.css package.json tsconfig.json tsconfig.build.json biome.json",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false src scripts tests website/site/report-demo.js website/site/community-voices.css website/site/report-interface.css website/site/staff-reports.css package.json tsconfig.json tsconfig.build.json biome.json",
    "lint": "biome lint src scripts tests website/site/report-demo.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/build-sites-worker.mjs",
    "cloudflare:staging:config": "node scripts/cloudflare-staging-config.mjs",
    "test": "npm run build && node --test",
    "test:d1": "node scripts/d1-local-check.mjs",
    "test:sites:d1": "npm run build && node scripts/sites-d1-local-check.mjs",
    "test:turnstile:d1": "npm run build && node scripts/turnstile-d1-local-check.mjs",
    "editor:dev": "npm run build && node scripts/editor-dev.mjs",
    "site:dev": "npm run build && node scripts/site-dev.mjs",
    "site:dev:empty": "npm run build && node scripts/site-dev.mjs --empty",
    "site:dev:banners": "npm run build && node scripts/site-dev.mjs --banner-fixtures",
    "reports:demo": "npm run build && node scripts/report-demo.mjs",
    "banners": "node scripts/banners.mjs",
    "profiles:mcp": "npm run build && node dist/mcp/profiles-stdio.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "pngjs": "^7.0.0",
    "sql.js": "1.16.0",
    "typescript": "5.8.3",
    "wrangler": "4.161.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.17",
    "jpeg-js": "^0.4.4"
  }
}
