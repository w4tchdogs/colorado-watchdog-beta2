{
  "name": "colorado-watchdog-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "format": "biome format --write src scripts tests package.json tsconfig.json tsconfig.build.json biome.json",`n    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false src scripts tests package.json tsconfig.json tsconfig.build.json biome.json",`n    "lint": "biome lint src scripts tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/build-sites-worker.mjs",
    "test": "npm run build && node --test",
    "test:d1": "node scripts/d1-local-check.mjs",
    "test:sites:d1": "node scripts/sites-d1-local-check.mjs",
    "editor:dev": "npm run build && node scripts/editor-dev.mjs",
    "site:dev": "npm run build && node scripts/site-dev.mjs",
    "site:dev:empty": "npm run build && node scripts/site-dev.mjs --empty",
    "site:dev:banners": "npm run build && node scripts/site-dev.mjs --banner-fixtures",
    "banners": "node scripts/banners.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "31.0.1",
    "pngjs": "^7.0.0",
    "sql.js": "1.16.0",
    "typescript": "5.8.3",
    "wrangler": "4.161.0"
  }
}
